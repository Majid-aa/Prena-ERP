FROM node:22-alpine AS build
WORKDIR /app
COPY src/Prena.Web/package.json src/Prena.Web/package-lock.json ./
RUN npm ci
COPY src/Prena.Web/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
